# CPMEMUTK turnkey build artifacts (local-use-only)
tk/cpmemutk.exe
tk/build.log
tk/build.xml

# Third-party CP/M boot disk (drop your own copy in tk/qpm22d01.unpacked/)
tk/qpm22d01.unpacked/

# M80/L80 binaries on the work disk (vendor, not redistributable here)
tk/src.unpacked/0/M80.COM
tk/src.unpacked/0/L80.COM

# Staged .MAC source on the work disk (regenerated by build.bat)
tk/src.unpacked/0/*.MAC

# CP/M intermediate + output artifacts on the work disk
tk/src.unpacked/0/*.REL
tk/src.unpacked/0/TETRIS.COM
